<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Disable the compiler warnings for undocumented members -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>


  <!-- NuGet Package Information Metadata -->
  <PropertyGroup>
    <PackageId>Infosoft.Info.Subscription.Dotnet</PackageId>
    <Version>1.0.0</Version>
    <Authors>Infosoft AS</Authors>
    <Company>Infosoft AS</Company>
    <Description>A dotnet SDK/client for the INFO-Subscription API.</Description>
    <PackageTags>info-subscription,client,sdk,subscription</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>infosoft-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
      <!-- The reproducable builds package basically does as this blog post describes, it just does it automatically!: https://devblogs.microsoft.com/dotnet/producing-packages-with-source-link/ -->
      <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.25">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Authentication.Azure" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="1.19.1" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="1.19.1" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.8" />
      <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.8" />
      <PackageReference Include="Azure.Identity" Version="1.15.0" />
      <PackageReference Include="MinVer" Version="6.0.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
  </ItemGroup>
  
  <!-- Copy various data such as infosoft-icon to the root package location -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
    <None Include="../../eng/infosoft-icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>
