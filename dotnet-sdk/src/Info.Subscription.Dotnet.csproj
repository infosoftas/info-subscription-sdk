<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Disable the compiler warnings for undocumented members -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>


  <!-- NuGet Package Information Metadata -->
  <PropertyGroup>
    <PackageId>Infosoft.Info.Subscription.Dotnet</PackageId>
    <Authors>Infosoft AS</Authors>
    <Company>Infosoft AS</Company>
    <Description>A dotnet SDK/client for the INFO-Subscription API.</Description>
    <PackageTags>info-subscription,client,sdk,subscription</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>infosoft-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Allow any Kiota 1.x release at or above the version we were generated against.
    A version range is used so that consumers are not locked to exactly 1.22.2, but
    a major-version upper bound prevents silent breakage if Kiota ships a 2.0 with
    breaking API changes.  Update KiotaVersion when regenerating against a newer
    Kiota tooling release.
  -->
  <PropertyGroup>
    <KiotaVersion>[1.22.2, 2.0.0)</KiotaVersion>
  </PropertyGroup>

  <ItemGroup>
      <!-- The reproducable builds package basically does as this blog post describes, it just does it automatically!: https://devblogs.microsoft.com/dotnet/producing-packages-with-source-link/ -->
      <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.2">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Kiota.Abstractions" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Authentication.Azure" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="$(KiotaVersion)" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.6" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.6" />
      <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.6" />
      <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>
  
  <!-- Copy various data such as infosoft-icon to the root package location -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../eng/infosoft-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
