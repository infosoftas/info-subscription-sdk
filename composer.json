{
  "name": "infosoftas/info-subscription-php",
  "description": "PHP SDK for INFO-Subscription API generated with Microsoft Kiota.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/infosoftas/info-subscription-sdk",
  "keywords": [
    "infosoft",
    "info-subscription",
    "kiota",
    "sdk",
    "php"
  ],
  "support": {
    "issues": "https://github.com/infosoftas/info-subscription-sdk/issues",
    "source": "https://github.com/infosoftas/info-subscription-sdk",
    "docs": "https://github.com/infosoftas/info-subscription-sdk/blob/main/php-sdk/README.md"
  },
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.9",
    "league/oauth2-client": "^2.6.1",
    "psr/http-message": "^1.1 || ^2.0",
    "microsoft/kiota-abstractions": "^2.2.2",
    "microsoft/kiota-authentication-phpleague": "^2.2.2",
    "microsoft/kiota-http-guzzle": "^2.2.2",
    "microsoft/kiota-serialization-form": "^2.2.2",
    "microsoft/kiota-serialization-json": "^2.2.2",
    "microsoft/kiota-serialization-multipart": "^2.2.2",
    "microsoft/kiota-serialization-text": "^2.2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Infosoft\\InfoSubscription\\Generated\\": "php-sdk/src/generated/",
      "Infosoft\\InfoSubscription\\": "php-sdk/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Infosoft\\InfoSubscription\\Tests\\": "php-sdk/tests/"
    }
  },
  "scripts": {
    "lint": "find php-sdk/src -type f -name '*.php' -exec php -l {} \\;",
    "test": "phpunit --configuration php-sdk/phpunit.xml.dist"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.git",
      "/.github",
      "/.superpowers",
      "/dotnet-sdk",
      "/typescript-sdk",
      "/python-sdk",
      "/eng",
      "/vendor",
      "/composer.lock",
      "/php-sdk/tests",
      "/php-sdk/Sample",
      "/php-sdk/Dockerfile",
      "/php-sdk/compose.yml"
    ]
  }
}
